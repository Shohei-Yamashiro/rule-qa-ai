# Store text files with LF in the repository; the working tree follows each machine's setting (CRLF on Windows).
* text=auto

# Windows PowerShell 5.1 reads scripts more reliably with CRLF.
*.ps1 text eol=crlf

# Git hooks run in sh, which needs LF.
.githooks/* text eol=lf

# Generated by scripts/TestReport.cs: keep our side on merge (needs scripts/setup-git.ps1), then regenerate.
docs/test-spec.md merge=ours linguist-generated=true

*.png binary
*.ico binary
*.zip binary
*.db binary
