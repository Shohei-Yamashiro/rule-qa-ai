@page "/settings"
@inject SettingsStore Store
@inject AiConnectionTester Tester
@inject RuleImporter Importer
@inject RuleSearchService Search
@inject IToastService Toast
@inject CurrentUser User

<PageTitle>設定</PageTitle>

<div class="page-head settings-head">
    <h2>設定</h2>
    <span class="spacer"></span>
    <span class="sub">変更は「保存」を押すと反映されます</span>
    <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size20.Save())" Disabled="@(!User.IsAdmin)" OnClick="Save">保存</FluentButton>
    <AdminBadge />
</div>

<div class="settings">
    <section class="panel" id="ai">
        <h3>AI の接続先</h3>
        <h4>使う AI</h4>
        <FluentRadioGroup TValue="AiProvider" @bind-Value="_s.Ai.Provider" Orientation="Orientation.Horizontal">
            <FluentRadio Value="AiProvider.None">使わない（検索のみ）</FluentRadio>
            <FluentRadio Value="AiProvider.OpenAiCompatible">OpenAI 互換 API</FluentRadio>
        </FluentRadioGroup>

        @if (_s.Ai.Provider == AiProvider.OpenAiCompatible)
        {
            <h4>接続先とモデル</h4>
            <p class="sub">Azure OpenAI・OpenAI・Gemini・Ollama・LM Studio など、OpenAI 互換の API に接続できます。プリセットで入力欄を埋めてから調整してください。</p>
            <div class="presets">
                @foreach (var p in Presets)
                {
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => ApplyPreset(p))">@p.Name</FluentButton>
                }
            </div>
            @if (_presetHint is not null)
            {
                <p class="sub preset-hint">@_presetHint</p>
            }
            <div class="row">
                <div class="field wide"><FluentTextField Label="エンドポイント" @bind-Value="_s.Ai.Endpoint" /></div>
                <div class="field"><FluentTextField Label="モデル" @bind-Value="_s.Ai.Model" /></div>
                <div class="field"><FluentTextField Label="API キー（ローカル LLM なら空欄）" TextFieldType="TextFieldType.Password" @bind-Value="_s.Ai.ApiKey" /></div>
                <div class="field"><FluentNumberField TValue="int" Label="タイムアウト（秒）" @bind-Value="_s.Ai.TimeoutSeconds" Min="5" /></div>
                <div class="field" style="align-self: end"><FluentCheckbox Label="JSON スキーマ指定を使う（非対応なら自動で切り替え）" @bind-Value="_s.Ai.UseJsonSchema" /></div>
            </div>

            <h4>埋め込みモデル（意味検索）</h4>
            <div class="row">
                <div class="field"><FluentTextField Label="埋め込みモデル（空欄ならキーワード検索のみ）" Placeholder="例: text-embedding-3-small" @bind-Value="_s.Ai.EmbeddingModel" /></div>
            </div>
            <p class="sub">設定すると、言葉が一致しない質問（「有給」と「年次有給休暇」など）も意味の近さで条文を探します。チャットと同じ接続先・API キーを使います（Azure OpenAI ではデプロイ名、Ollama では bge-m3 など）。</p>
        }
        else
        {
            <p class="sub">AI を使わないときは、質問に近い条文を検索して「該当しそうな条文」として表示します。AI を用意しなくても動作を確認できます。</p>
        }

        <h4>動作確認</h4>
        <p class="sub">保存前の設定で、AI に短い質問を 1 回送ります。埋め込みモデルを設定していれば、それも確かめます。</p>
        <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.PlugConnected())" Disabled="_testing" OnClick="TestAiAsync">接続テスト</FluentButton>
        @if (_testing)
        {
            <FluentProgressRing Width="16px" Style="display: inline-block; margin-left: 8px" />
        }
        @if (_testResult is not null)
        {
            <div class="test-result">@_testResult</div>
        }
    </section>

    <section class="panel" id="rules">
        <h3>規則の取り込み</h3>
        <p class="sub">フォルダの中の .md と .txt（サブフォルダを含む）を「第○条」ごとに分けて取り込みます。条のない文書は見出しか段落で分けます。2 回目からは内容が変わったファイルだけを取り込み直します。同じ規程名の文書が複数あれば、施行日・改定日が最も新しいものを最新版とし、それ以外と「廃止」「旧版」と書かれたものは旧版として扱います。</p>
        <div class="row">
            <div class="field wide">
                <FluentTextField Label="フォルダ（相対パスはアプリの場所から）" @bind-Value="_s.Rules.Folder" />
                <div class="sub">@Importer.ResolveFolder(_s.Rules.Folder)</div>
            </div>
        </div>
        <div class="actions" style="margin-top: 0">
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowImport())" Disabled="@(_rulesBusy || !User.IsAdmin)" OnClick="ImportAsync">変更を取り込む</FluentButton>
            <AdminBadge />
            <span class="sub" style="align-self: center">@StatsText</span>
        </div>
        <p class="sub">変更のあったファイルの確認、規程ごとの取り込み、すべての取り込み直し、取り込みの記録は<a href="rules">規則一覧</a>の「取り込みの管理」から行えます。</p>
        @if (_importWarnings is { Count: > 0 })
        {
            <div class="test-result">@string.Join("\n", _importWarnings)</div>
        }

        <h4>検索</h4>
        <div class="row">
            <div class="field"><FluentNumberField TValue="int" Label="候補にする条文の数（AI に渡す数）" @bind-Value="_s.Rules.CandidateCount" Min="1" Max="20" /></div>
            <div class="field" style="align-self: end"><FluentSwitch Label="旧版も検索する" @bind-Value="_s.Rules.IncludeSuperseded" /></div>
        </div>
        <p class="sub">キーワード（文字の並び）で検索します。埋め込みモデルを設定してベクトルを作ると、意味の近さでの検索も合わせます。FAQ などの参考資料は、規程より下に並びます。</p>
        @if (_s.Ai.Provider == AiProvider.OpenAiCompatible && !string.IsNullOrWhiteSpace(_s.Ai.EmbeddingModel))
        {
            <div class="actions" style="margin-top: 0">
                <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.DataUsage())" Disabled="@(_rulesBusy || !User.IsAdmin)" OnClick="BuildVectorsAsync">ベクトルを作成</FluentButton>
                <AdminBadge />
                @if (_rulesBusy && _progress is not null)
                {
                    <FluentProgressRing Width="16px" Style="align-self: center" />
                    <span class="sub" style="align-self: center">@_progress</span>
                }
            </div>
        }

        <h4>試しに検索</h4>
        <div class="row">
            <div class="field wide"><FluentTextField Label="質問" Placeholder="質問を入力して Enter" Immediate="true" @bind-Value="_searchText" @onkeydown="SearchOnEnterAsync" /></div>
        </div>
        <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.Search())" Disabled="@(_rulesBusy || string.IsNullOrWhiteSpace(_searchText))" OnClick="SearchAsync">検索</FluentButton>
        @if (_hits is not null)
        {
            if (_hits.Count == 0)
            {
                <p class="sub">候補は見つかりませんでした。</p>
            }
            else
            {
                <table class="eval-table">
                    <tr><th>順位</th><th>条文</th><th>キーワード</th><th>意味（ベクトル）</th></tr>
                    @foreach (var (h, i) in _hits.Select((h, i) => (h, i)))
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>
                                @h.Article.DisplayName
                                @if (h.Article.Document.IsSuperseded)
                                {
                                    <span class="badge badge-old">旧版</span>
                                }
                                @if (h.Article.Document.Kind == DocumentKind.Reference)
                                {
                                    <span class="badge">参考資料</span>
                                }
                                <div class="sub">@Preview(h.Article.Body)</div>
                            </td>
                            <td>@h.Keyword.ToString("0.0")</td>
                            <td>@(h.Vector?.ToString("0.00") ?? "－")</td>
                        </tr>
                    }
                </table>
            }
        }
    </section>

    <section class="panel" id="prompt">
        <h3>AI への指示（プロンプト） <AdminBadge /></h3>
        <p class="sub">回答を作るときに AI に渡す指示です（AI を使うときだけ使います）。変えたら、下の「評価」の「回答を評価」で効果を確かめてから保存できます。</p>
        <FluentTextArea Rows="12" Resize="TextAreaResize.Vertical" Style="width: 100%" @bind-Value="_s.Ai.Instructions" Disabled="@(!User.IsAdmin)" />
        <div class="actions" style="margin-top: 4px">
            <span class="sub" style="align-self: center">@(RuleAnswerService.IsDefaultInstructions(_s.Ai.Instructions) ? "既定の指示です。" : "既定の指示から変更しています（保存すると質問に使います）。")</span>
            <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.ArrowUndo())" Disabled="@(!User.IsAdmin || RuleAnswerService.IsDefaultInstructions(_s.Ai.Instructions))" OnClick="ResetInstructions">既定に戻す</FluentButton>
        </div>
        <h4>常に付け足す指示（編集できません）</h4>
        <p class="sub">回答の読み取りと根拠の条文の確認に使うため、上の指示の後ろに毎回付けます。</p>
        <div class="test-result">@RuleAnswerService.FixedInstructions</div>
    </section>

    <EvaluationPanel Settings="@(() => _s.Copy())" />

    <p class="sub">API キーは Windows のユーザーごとに暗号化して保存します。</p>
</div>

@code {
    private sealed record Preset(string Name, string Endpoint, string Model, string? Hint = null);

    private static readonly Preset[] Presets =
    [
        new("Azure OpenAI", "https://YOUR-RESOURCE.openai.azure.com/openai/v1", "gpt-4.1-mini",
            "エンドポイントの YOUR-RESOURCE を Azure OpenAI のリソース名に、モデルをデプロイ名に置き換えてください。API キーは Azure ポータルの「キーとエンドポイント」にあります（api-key ヘッダーで送ります）。"),
        new("OpenAI", "https://api.openai.com/v1", "gpt-4.1-mini"),
        new("Gemini", "https://generativelanguage.googleapis.com/v1beta/openai", "gemini-2.5-flash"),
        new("Ollama", "http://localhost:11434/v1", "qwen2.5:7b", "API キーは空欄のままで使えます。事前に ollama pull でモデルを取得してください。"),
        new("LM Studio", "http://localhost:1234/v1", "", "LM Studio で読み込んだモデル名を入力してください。API キーは空欄で使えます。"),
    ];

    private AppSettings _s = new();
    private string? _presetHint;
    private bool _testing;
    private string? _testResult;

    private bool _rulesBusy;
    private string? _progress;
    private LibraryStats? _stats;
    private IReadOnlyList<string>? _importWarnings;
    private string? _searchText;
    private IReadOnlyList<ArticleHit>? _hits;

    protected override async Task OnInitializedAsync()
    {
        _s = Store.Current;
        if (RuleAnswerService.IsDefaultInstructions(_s.Ai.Instructions)) _s.Ai.Instructions = RuleAnswerService.DefaultInstructions;
        await RefreshStatsAsync();
    }

    private string StatsText => _stats is not { } s ? "…"
        : s.Documents == 0 ? "まだ取り込んでいません。"
        : $"規程 {s.Documents} 件（うち旧版 {s.Superseded}・参考資料 {s.References}）・条文 {s.Articles} 件"
          + (_s.Ai.Provider == AiProvider.OpenAiCompatible && !string.IsNullOrWhiteSpace(_s.Ai.EmbeddingModel) ? $"・ベクトル作成済み {s.Embedded} 件" : "");

    private async Task RefreshStatsAsync() => _stats = await Importer.StatsAsync(_s.Ai.EmbeddingModel);

    private async Task ImportAsync()
    {
        _rulesBusy = true;
        try
        {
            if (!User.IsAdmin) return;
            var r = await Importer.ImportFolderAsync(_s.Rules.Folder);
            _importWarnings = r.Warnings;
            var summary = $"追加 {r.Added}・更新 {r.Updated}・削除 {r.Removed}・変更なし {r.Unchanged}";
            if (r.Changed == 0 && r.Unchanged == 0 && r.Warnings.Count > 0) Toast.ShowError("取り込めませんでした。" + string.Join(" ", r.Warnings));
            else Toast.ShowSuccess($"取り込みました（{summary}）。" + (r.KeptVectors > 0 ? $"作成済みのベクトル {r.KeptVectors} 件はそのまま使います。" : ""));
            _hits = null;
        }
        finally
        {
            _rulesBusy = false;
            await RefreshStatsAsync();
        }
    }

    private async Task BuildVectorsAsync()
    {
        _rulesBusy = true;
        var progress = new Progress<string>(p =>
        {
            _progress = p;
            StateHasChanged();
        });
        try
        {
            var count = await Search.BuildEmbeddingsAsync(_s.Copy().Ai, progress);
            Toast.ShowSuccess(count == 0 ? "すべての条文のベクトルを作成済みです。" : $"{count} 件のベクトルを作成しました。設定を保存すると質問で使います。");
        }
        catch (Exception e)
        {
            Toast.ShowError("ベクトルを作成できませんでした: " + e.Message);
        }
        finally
        {
            _rulesBusy = false;
            _progress = null;
            await RefreshStatsAsync();
        }
    }

    private async Task SearchOnEnterAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchText)) await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _rulesBusy = true;
        try
        {
            _hits = await Search.SearchAsync(_searchText ?? "", _s.Copy());
        }
        finally
        {
            _rulesBusy = false;
        }
    }

    private static string Preview(string body)
    {
        var line = body.Replace('\n', ' ');
        return line.Length > 80 ? line[..80] + "…" : line;
    }

    private void ResetInstructions() => _s.Ai.Instructions = RuleAnswerService.DefaultInstructions;

    private void ApplyPreset(Preset p)
    {
        _s.Ai.Endpoint = p.Endpoint;
        _s.Ai.Model = p.Model;
        _presetHint = p.Hint;
    }

    private void Save()
    {
        if (!User.IsAdmin) return;
        _s.Ai.TimeoutSeconds = Math.Max(5, _s.Ai.TimeoutSeconds);
        _s.Rules.CandidateCount = Math.Clamp(_s.Rules.CandidateCount, 1, RuleSearchService.MaxCandidates);
        var saved = _s.Copy();
        if (RuleAnswerService.IsDefaultInstructions(saved.Ai.Instructions)) saved.Ai.Instructions = "";
        Store.Save(saved);
        Toast.ShowSuccess("設定を保存しました。");
    }

    private async Task TestAiAsync()
    {
        _testing = true;
        _testResult = null;
        try
        {
            _testResult = await Tester.TestAsync(_s.Copy().Ai, CancellationToken.None);
        }
        finally
        {
            _testing = false;
        }
    }
}
