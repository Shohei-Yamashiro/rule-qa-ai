@page "/"
@inject SettingsStore Store
@inject RuleImporter Importer

<PageTitle>質問</PageTitle>

<div class="page-head">
    <h2>質問</h2>
</div>

<section class="panel">
    <p>社内規則についての質問に、根拠の条文を添えて答えるチャットボットです。</p>
    <p class="sub">質問の機能は準備中です。今は <a href="settings#rules">設定</a> の「試しに検索」で、質問に近い条文を探せます。</p>
    <p class="sub">取り込んだ規則：@_stats</p>
    <p class="sub">現在の設定：@AiStatus</p>
</section>

@code {
    private string _stats = "…";

    protected override async Task OnInitializedAsync()
    {
        var s = await Importer.StatsAsync(null);
        _stats = s.Documents == 0 ? "まだありません" : $"規程 {s.Documents} 件（うち旧版 {s.Superseded}・参考資料 {s.References}）・条文 {s.Articles} 件";
    }

    private string AiStatus => Store.Current.Ai is { Provider: AiProvider.OpenAiCompatible } ai
        ? $"AI を使う（{ai.Model}）" + (string.IsNullOrWhiteSpace(ai.EmbeddingModel) ? "" : $"・埋め込みモデル {ai.EmbeddingModel}")
        : "AI を使わない（検索で見つかった条文を表示）";
}
