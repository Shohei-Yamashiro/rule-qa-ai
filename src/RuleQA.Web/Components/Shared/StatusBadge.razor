<span class="badge @Css(Status)">@Label(Status)</span>

@code {
    [Parameter, EditorRequired]
    public AnswerStatus Status { get; set; }

    public static string Label(AnswerStatus status) => status switch
    {
        AnswerStatus.Answered => "回答",
        AnswerStatus.NotInRules => "記載なし",
        AnswerStatus.OffTopic => "対象外",
        _ => "検索のみ",
    };

    private static string Css(AnswerStatus status) => status switch
    {
        AnswerStatus.Answered => "badge-ok",
        AnswerStatus.NotInRules or AnswerStatus.OffTopic => "badge-none",
        _ => "",
    };
}
