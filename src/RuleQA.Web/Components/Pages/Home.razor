@page "/"
@using System.Diagnostics
@inject SettingsStore Store
@inject RuleImporter Importer
@inject RuleLibrary Library
@inject RuleAnswerService Answers
@inject QaHistory History
@inject NavigationManager Nav
@inject ILogger<Home> Logger

<PageTitle>質問</PageTitle>

<div class="page-head">
    <h2>質問</h2>
    <span class="spacer"></span>
    <span class="sub">@AiStatus</span>
    <FluentButton Appearance="Appearance.Outline" IconStart="@(new Icons.Regular.Size16.ChatAdd())" Disabled="@(_busy || _turns.Count == 0)" OnClick="NewConversation">新しい会話</FluentButton>
</div>

<div class="chat">
    @if (_turns.Count == 0)
    {
        <section class="panel">
            @if (_stats is { Documents: 0 })
            {
                <p>規則がまだ取り込まれていません。<a href="settings#rules">設定</a>の「規則の取り込み」で、規則ファイルのフォルダを取り込むと質問できるようになります。</p>
            }
            else
            {
                <p>取り込んだ社内規則についての質問に、根拠の条文を添えて答えます。規則に書かれていないことは「規則には記載がありません」と答えます。前の回答を受けて「その場合は？」のように続けて聞くこともできます。</p>
                @if (_popular.Count > 0)
                {
                    <h4 class="topics-head">よくある質問（直近 @PopularDays 日）</h4>
                    <div class="suggestions">
                        @foreach (var p in _popular)
                        {
                            <button class="suggestion" title="@($"{p.Count} 回・最後は {p.LastAskedUtc.ToLocalTime():yyyy/MM/dd}")" @onclick="() => Fill(p.Question)">@p.Question<span class="suggestion-count">@p.Count</span></button>
                        }
                    </div>
                }
                @if (_examples.Count > 0)
                {
                    <h4 class="topics-head">@(_popular.Count > 0 ? "ほかにも、こんなことを聞けます" : "例えば、こんなことを聞けます")</h4>
                    <div class="suggestions">
                        @foreach (var e in _examples)
                        {
                            <button class="suggestion" @onclick="() => Fill(e.Question)">@e.Question</button>
                        }
                    </div>
                }
                @if (_stats is { Titles.Count: > 0 } s)
                {
                    <p class="sub rules-summary">
                        取り込んだ規程 @s.Titles.Count 件：@string.Join("・", s.Titles.Take(TitlesShown))@(s.Titles.Count > TitlesShown ? $" ほか {s.Titles.Count - TitlesShown} 件" : "")
                        （<a href="rules">規則一覧で見る</a>）
                    </p>
                }
                <p class="sub">@StatsText</p>
            }
            @if (_notFound)
            {
                <p class="sub chat-error">指定された会話は履歴にありません。新しい会話を始めます。</p>
            }
        </section>
    }
    else if (_restored)
    {
        <div class="sub">履歴から会話を開きました。続けて質問できます。</div>
    }

    @foreach (var turn in _turns)
    {
        <div class="chat-question">@turn.Question</div>
        <section class="panel chat-answer">
            @if (turn.Answer is not { } a)
            {
                <div class="chat-status"><FluentProgressRing Width="16px" /> <span class="sub">回答を作っています…</span></div>
            }
            else
            {
                <div class="chat-status">
                    <StatusBadge Status="a.Status" />
                    @if (a.AiName is not null)
                    {
                        <span class="sub">@a.AiName</span>
                    }
                </div>
                <div class="chat-text">@a.Text</div>
                @if (a.Status == AnswerStatus.OffTopic)
                {
                    <div class="sub">取り込んだ規程と条文は <a href="rules">規則一覧</a> で確認できます。</div>
                }
                @if (a.Error is not null)
                {
                    <div class="sub chat-error">@a.Error</div>
                }
                @if (a.Citations.Count > 0)
                {
                    <h4>根拠の条文</h4>
                    @foreach (var article in a.Citations)
                    {
                        <ArticleDetails Article="article" ShowLink="true" />
                    }
                }
                else if (a.Candidates.Count > 0 && a.Status != AnswerStatus.OffTopic)
                {
                    <h4>@(a.Status == AnswerStatus.NotInRules ? "関連しそうな条文" : "該当しそうな条文")</h4>
                    @foreach (var hit in a.Candidates)
                    {
                        <ArticleDetails Article="hit.Article" ShowLink="true" />
                    }
                }
                @if (a.DroppedCitations.Count > 0)
                {
                    <div class="sub">候補にない条文 ID を根拠から外しました：@string.Join("、", a.DroppedCitations)</div>
                }
                @if (turn.Missing.Count > 0)
                {
                    <div class="sub missing">今の規則にない条文：@string.Join("、", turn.Missing)</div>
                }
            }
        </section>
    }

    <div class="chat-input">
        <FluentTextField @ref="_input" Placeholder="@(NoRules ? "規則を取り込むと質問できます" : "質問を入力して Enter")" Immediate="true" @bind-Value="_question" @onkeydown="OnKeyDownAsync" Disabled="@(_busy || NoRules)" />
        <FluentButton Appearance="Appearance.Accent" IconStart="@(new Icons.Regular.Size16.Send())" Disabled="@(_busy || NoRules || string.IsNullOrWhiteSpace(_question))" OnClick="AskAsync">送信</FluentButton>
    </div>
</div>

@code {
    private sealed class Turn(string question)
    {
        public string Question { get; } = question;
        public RuleAnswer? Answer { get; set; }
        public IReadOnlyList<string> Missing { get; init; } = [];
    }

    /// <summary>A conversation from the history to continue.</summary>
    [SupplyParameterFromQuery(Name = "c")]
    public string? ConversationParameter { get; set; }

    private readonly List<Turn> _turns = [];
    private FluentTextField? _input;
    private string? _question;
    private bool _busy;
    private const int SuggestionCount = 6;
    private const int PopularDays = 90;
    private const int TitlesShown = 3;
    private LibraryStats? _stats;
    private IReadOnlyList<PopularQuestion> _popular = [];
    private IReadOnlyList<RuleExample> _examples = [];
    private string _conversationId = QaHistory.NewConversationId();
    private string? _loaded;
    private bool _restored;
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        _stats = await Importer.StatsAsync(null);
        _popular = await History.PopularAsync(SuggestionCount, PopularDays);
        _examples = RuleLibrary.PickExamples(await Library.TopicsAsync(), SuggestionCount - _popular.Count, Random.Shared);
    }

    private void Fill(string question)
    {
        _question = question;
        _input?.FocusAsync();
    }

    private bool NoRules => _stats is { Documents: 0 } && _turns.Count == 0;

    private string StatsText => _stats is not { } s ? "" :
        $"取り込んだ規則：文書 {s.Documents} 件（うち旧版 {s.Superseded}・参考資料 {s.References}）・条文 {s.Articles} 件"
        + (s.LastImportedUtc is { } t ? $" ・ 最終取り込み {t.ToLocalTime():yyyy/MM/dd HH:mm}" : "");

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(ConversationParameter) || ConversationParameter == _loaded) return;
        _loaded = ConversationParameter;
        _turns.Clear();
        var entries = await History.ConversationAsync(ConversationParameter);
        _restored = entries.Count > 0;
        _notFound = entries.Count == 0;
        _conversationId = _restored ? ConversationParameter : QaHistory.NewConversationId();
        foreach (var entry in entries)
            _turns.Add(new Turn(entry.Record.Question) { Answer = entry.ToAnswer(), Missing = entry.MissingKeys });
    }

    private string AiStatus => Store.Current.Ai is { Provider: AiProvider.OpenAiCompatible } ai
        ? $"AI：{ai.Model}" + (string.IsNullOrWhiteSpace(ai.EmbeddingModel) ? "" : $"・埋め込み：{ai.EmbeddingModel}")
        : "AI を使わない（検索のみ）";

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.IsComposing) await AskAsync();
    }

    private async Task AskAsync()
    {
        var question = _question?.Trim();
        if (_busy || string.IsNullOrEmpty(question)) return;
        var history = _turns.Where(t => t.Answer is not null).Select(t => new ConversationTurn(t.Question, t.Answer!.Text)).ToList();
        var turn = new Turn(question);
        _turns.Add(turn);
        _question = null;
        _notFound = false;
        _busy = true;
        StateHasChanged();
        var watch = Stopwatch.StartNew();
        try
        {
            turn.Answer = await Answers.AnswerAsync(question, history, Store.Current);
        }
        catch (Exception e)
        {
            turn.Answer = new RuleAnswer(question, AnswerStatus.SearchOnly, "回答を作れませんでした。", [], [], [], e.Message, null);
        }
        finally
        {
            _busy = false;
        }
        try
        {
            await History.SaveAsync(_conversationId, turn.Answer, watch.Elapsed);
        }
        catch (Exception e)
        {
            Logger.LogWarning(e, "Could not save the question to the history");
        }
        StateHasChanged();
        _input?.FocusAsync();
    }

    private void NewConversation()
    {
        _turns.Clear();
        _question = null;
        _restored = false;
        _notFound = false;
        _conversationId = QaHistory.NewConversationId();
        if (!string.IsNullOrEmpty(ConversationParameter))
        {
            _loaded = null;
            Nav.NavigateTo("/");
        }
    }
}
